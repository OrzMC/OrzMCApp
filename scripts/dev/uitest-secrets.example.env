# 真实服务器 / 真实账号的 UI 测试凭据（**模板**）
#
# 用法：
#   cp scripts/dev/uitest-secrets.example.env scripts/dev/uitest-secrets.env
#   然后在 uitest-secrets.env 里填真实值（该文件已被 .gitignore 忽略，永不入库）。
#
# 安全约定（务必遵守）：
#   * 这个文件只在本地存在，不进仓库、不进 PR、不进提交信息、不进 CI。
#   * runner 只加载并传给测试进程，**不回显值**（日志里只显示"已提供/未提供"）。
#   * 一旦误提交：立刻在服务器/exaroton 侧轮换（改 RCON 密码 / 重置 Token），再清理 git 历史。
#   * `scripts/dev/check-secrets.py` 会在 pre-push 时检查暂存内容里有没有这些值。

# ── 自建服务器（真实 SLP + RCON） ─────────────────────────────
# 主机名或 IP，不要带协议、不要带端口
ORZMC_UITEST_SELFHOSTED_HOST=
# SLP 端口（一般是 25565）
ORZMC_UITEST_SELFHOSTED_PORT=25565
# RCON 端口（server.properties 里的 rcon.port，一般 25575）
ORZMC_UITEST_SELFHOSTED_RCON_PORT=25575
# RCON 密码（server.properties 里的 rcon.password）
ORZMC_UITEST_SELFHOSTED_RCON_PASSWORD=
# 服务器显示名（测试里断言这个名字出现）
ORZMC_UITEST_SELFHOSTED_NAME=真机测试服

# ── exaroton 真实账号 ────────────────────────────────────────
# 账号 Token（exaroton 控制台 → Account → API）
ORZMC_UITEST_EXAROTON_TOKEN=
