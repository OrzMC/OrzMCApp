    },
    "Same four values as the CLI's --type.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 CLI 的 --type 取值相同。"
          }
        }
      }
    },
    "Only used when the game mode is Server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在游戏模式为服务器时使用。"
          }
        }
      }
    },
    "Adds -agentlib:jdwp=… to the server JVM so a debugger can attach. Keep it off unless you need it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给服务端 JVM 加 -agentlib:jdwp=…，供调试器连接。不需要就别开。"
          }
        }
      }
    },
    "%@ server": {
