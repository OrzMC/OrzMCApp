          "stringUnit": {
            "state": "translated",
            "value": "离线客户端启动使用的玩家名"
          }
        }
      }
    },
    "Java requirement is unknown until a version is selected. Click to rescan.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择版本后才能确定 Java 需求。点击重新扫描。"
          }
        }
      }
    },
    "This version needs Java %@; installed: %@. Click to rescan.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该版本需要 Java %@；本机已装 %@。点击重新扫描。"
          }
        }
      }
    },
    "This version needs Java %@; it will be installed on launch. Installed: %@. Click to rescan.": {
      "localizations": {
