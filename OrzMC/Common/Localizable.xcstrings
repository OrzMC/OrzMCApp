    "Removes the address, the saved RCON password and the console history on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会删掉地址、已保存的 RCON 密码和本机的控制台记录。"
          }
        }
      }
    },
    "Removes the address, the saved RCON password and the console history on this device. The server itself is not touched.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会删掉地址、已保存的 RCON 密码和本机的控制台记录；服务器本身不受影响。"
