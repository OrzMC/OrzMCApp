    "Show the managed Java folder in Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中显示 Java 目录"
          }
        }
      }
    },
    "Managed by the engine: a missing version is downloaded on launch, so this never blocks you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由引擎托管：缺失的版本会在启动时自动下载，不需要你手动处理。"
          }
        }
      }
    },
    "One folder per instance — switching the folder switches every instance.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个实例一个游戏目录——换目录等于换一整套实例。"
          }
        }
      }
    },
    "Same as the CLI's --root-dir.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 CLI 的 --root-dir 相同。"
          }
        }
      }
    },
    "Same rules as the CLI's --min-mem / --max-mem.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则与 CLI 的 --min-mem / --max-mem 相同。"
